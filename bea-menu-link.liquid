{%- capture bea_subs -%}{% content_for 'blocks' %}{%- endcapture -%}
<li class="bea-menu__item" {{ block.shopify_attributes }}>
  {%- if bea_subs != blank %}
  <details class="bea-menu__details" id="BeaMenu-{{ block.id | handle }}">
    <summary class="bea-menu__link bea-menu__link--parent">{{ block.settings.title }}<span class="bea-menu__icon" aria-hidden="true"></span></summary>
    <span class="bea-menu__anchor" hidden aria-hidden="true"></span>
  </details>
  <ul class="bea-menu__submenu list-unstyled" role="list">
    {{- bea_subs -}}
  </ul>
  {%- else %}
  <a class="bea-menu__link" href="{% render 'bea-menu-href', url: block.settings.link %}">{{ block.settings.title }}</a>
  {%- endif %}
</li>

{% schema %}
{
  "name": "Enlace o desplegable",
  "tag": null,
  "blocks": [{ "type": "bea-menu-sublink" }],
  "settings": [
    { "type": "text", "id": "title", "label": "Texto", "default": "Enlace" },
    { "type": "url", "id": "link", "label": "Enlace", "info": "Solo se usa si no tiene subenlaces. Si añades subenlaces, se convierte en desplegable." }
  ],
  "presets": [{ "name": "Enlace o desplegable" }]
}
{% endschema %}
