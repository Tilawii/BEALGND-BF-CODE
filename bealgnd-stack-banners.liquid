{%- comment -%}
  BEALGND · Banners apilables (efecto stack con sticky)
  Cada bloque es un banner (imagen o vídeo + título + enlace). Al hacer scroll,
  cada banner se queda fijo y el siguiente se monta encima (efecto pila).
{%- endcomment -%}

{%- style -%}
  .bea-stack--{{ section.id }} {
    position: relative;
    {% if section.settings.stack_effect %}z-index: 1;{% endif %}
  }
  .bea-stack__item--{{ section.id }} {
    position: relative;
    height: var(--bea-bh, 80vh);
    overflow: hidden;
    {% if section.settings.stack_effect %}
      position: sticky;
      top: 0;
    {% endif %}
  }
  .bea-stack__media { position: absolute; inset: 0; background: #111; }
  .bea-stack__img,
  .bea-stack__video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bea-stack__overlay { position: absolute; inset: 0; background: #000; opacity: var(--bea-overlay, 0.3); }

  /* Placeholder cuando no hay imagen ni vídeo (oscuro, tipo hero) */
  .bea-stack__placeholder {
    position: absolute; inset: 0;
    display: flex; align-items: flex-end; justify-content: center;
    padding-bottom: 16px;
    background: #1a1a1a;
    color: rgba(255,255,255,.4);
  }
  /* Alterna el tono para diferenciar banners al apilarse */
  .bea-stack__item--{{ section.id }}:nth-child(even) .bea-stack__placeholder {
    background: #2e2e2e;
  }
  .bea-stack__placeholder span {
    font-family: var(--font-body-family);
    font-size: 13px; letter-spacing: .02em;
  }

  .bea-stack__content {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center; padding: 20px;
    color: var(--bea-text, #fff);
    z-index: 2;
  }
  .bea-stack__title {
    color: var(--bea-text, #fff);
    font-family: "Inter", var(--font-heading-family);
    font-weight: 500;
    font-size: var(--bea-title-size, 24px);
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 0 0 12px;
    text-transform: none;
  }
  .bea-stack__link {
    color: var(--bea-text, #fff);
    font-family: var(--font-body-family);
    font-size: 14px; font-weight: 500;
    text-decoration: underline; text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .bea-stack__link:hover { color: var(--bea-text, #fff); }
  .bea-stack__link::before { content: "\2192\00a0"; }

  @media screen and (min-width: 750px) {
    .bea-stack__title { font-size: var(--bea-title-size-d, 40px); }
    .bea-stack__link { font-size: 16px; }
  }
{%- endstyle -%}

<div class="bea-stack bea-stack--{{ section.id }}">
  {%- for block in section.blocks -%}
    <div
      class="bea-stack__item bea-stack__item--{{ section.id }}"
      style="
        --bea-bh: {{ section.settings.height }}vh;
        --bea-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
        --bea-text: {{ section.settings.text_color }};
        --bea-title-size: {{ section.settings.title_size }}px;
        --bea-title-size-d: {{ section.settings.title_size_desktop }}px;
      "
      {{ block.shopify_attributes }}
    >
      <div class="bea-stack__media">
        {%- if block.settings.video != blank -%}
          {{
            block.settings.video
            | video_tag:
              image_size: '1600x',
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              class: 'bea-stack__video'
          }}
          <div class="bea-stack__overlay"></div>
        {%- elsif block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 2000
            | image_tag:
              loading: 'lazy',
              sizes: '100vw',
              widths: '360,540,720,900,1200,1600,2000',
              class: 'bea-stack__img'
          }}
          <div class="bea-stack__overlay"></div>
        {%- else -%}
          <div class="bea-stack__placeholder">
            <span>Imagen o vídeo</span>
          </div>
        {%- endif -%}
      </div>
      <div class="bea-stack__content">
        {%- if block.settings.title != blank -%}
          <h2 class="bea-stack__title">{{ block.settings.title }}</h2>
        {%- endif -%}
        {%- if block.settings.link_label != blank -%}
          <a class="bea-stack__link" href="{{ block.settings.link_url | default: '#' }}">{{ block.settings.link_label }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "BEALGND · Banners",
  "tag": "section",
  "class": "bea-stack-section",
  "settings": [
    { "type": "checkbox", "id": "stack_effect", "label": "Efecto apilado al hacer scroll", "default": true },
    { "type": "range", "id": "height", "min": 40, "max": 100, "step": 5, "unit": "vh", "label": "Altura de cada banner", "default": 80 },
    { "type": "header", "content": "Estilo" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Oscurecer imagen", "default": 30 },
    { "type": "color", "id": "text_color", "label": "Color del texto", "default": "#ffffff" },
    { "type": "range", "id": "title_size", "min": 16, "max": 48, "step": 1, "unit": "px", "label": "Tamaño título (móvil)", "default": 24 },
    { "type": "range", "id": "title_size_desktop", "min": 24, "max": 90, "step": 2, "unit": "px", "label": "Tamaño título (escritorio)", "default": 40 }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "video", "id": "video", "label": "Vídeo", "info": "Si pones vídeo, tiene prioridad sobre la imagen." },
        { "type": "text", "id": "title", "label": "Título", "default": "TENNIS BRACELETS" },
        { "type": "text", "id": "link_label", "label": "Texto del enlace", "default": "SHOP NOW" },
        { "type": "url", "id": "link_url", "label": "Enlace" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "BEALGND · Banners",
      "blocks": [
        { "type": "banner", "settings": { "title": "TENNIS BRACELETS", "link_label": "SHOP NOW" } },
        { "type": "banner", "settings": { "title": "TENNIS BRACELETS", "link_label": "SHOP NOW" } }
      ]
    }
  ]
}
{% endschema %}
