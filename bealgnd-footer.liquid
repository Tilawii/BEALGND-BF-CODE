{%- comment -%}
  BEALGND · Footer (calcado del Figma)
  - Pill "To Make a Return" superpuesta arriba
  - Logo centrado
  - Newsletter (formulario real de Shopify)
  - Iconos sociales (bloques)
  - Menús desplegables (acordeones) por bloque
  - Selector de país/idioma nativo de Shopify
  - Copyright
{%- endcomment -%}

{%- style -%}
  .bea-ft {
    position: relative;
    background: {{ section.settings.bg_color }};
    color: #121212;
    padding: 0 24px 28px;
    margin-top: {{ section.settings.top_spacing }}px;
    font-family: "Inter", var(--font-body-family);
  }

  /* Pill superior — sobresale hacia ARRIBA, esquinas redondeadas al techo */
  .bea-ft { padding-top: 0 !important; position: relative; z-index: 5; overflow: visible; }
  .bea-ft__pill-wrap {
    display: flex; justify-content: center;
    height: 0; margin: 0 0 34px; overflow: visible;
  }
  .bea-ft__pill {
    display: inline-flex;
    align-items: center; justify-content: center;
    height: auto !important;
    min-height: 30px;
    box-sizing: border-box;
    transform: translateY(-100%);
    background: rgba(0,0,0,.8); backdrop-filter: blur(15px);
    color: #fff;
    font-family: "Inter", var(--font-body-family);
    font-size: 12px; font-weight: 400; letter-spacing: -0.03em; line-height: 1;
    padding: 0 70px;
    border-radius: 8px 8px 0 0;
    text-decoration: none; white-space: nowrap;
    position: relative; z-index: 6;
  }

  .bea-ft__inner { max-width: 480px; margin: 0 auto; }

  /* Logo */
  .bea-ft__logo { text-align: center; margin: 6px 0 14px; }
  .bea-ft__logo img { height: {{ section.settings.logo_height }}px; width: auto; display: inline-block; }

  /* Newsletter */
  .bea-ft__nl-label {
    text-align: center; font-size: 11px; letter-spacing: -0.03em;
    color: #121212; margin: 0 0 14px;
  }
  .bea-ft__nl { position: relative; margin: 0 0 26px; }
  .bea-ft__nl input[type="email"] {
    width: 100%; border: 0; border-bottom: 1px solid #121212;
    background: transparent; padding: 8px 30px 8px 0;
    font-size: 12px; color: #121212; letter-spacing: -0.03em;
    font-family: inherit; border-radius: 0;
  }
  .bea-ft__nl input[type="email"]::placeholder { color: #505050; }
  .bea-ft__nl input:focus { outline: none; }
  .bea-ft__nl button {
    position: absolute; right: 0; top: 50%; transform: translateY(-50%);
    background: transparent; border: 0; cursor: pointer; padding: 4px;
    color: #121212; line-height: 0;
  }
  .bea-ft__nl button svg { width: 20px; height: 20px; }
  .bea-ft__nl-msg { font-size: 11px; margin-top: 8px; color: #505050; }

  /* Social */
  .bea-ft__social { display: flex; justify-content: center; gap: 34px; margin: 0 0 34px; }
  .bea-ft__social a { color: #121212; line-height: 0; }
  .bea-ft__social svg { width: 22px; height: 22px; display: block; }

  /* Acordeones */
  .bea-ft__acc { border: 0; }
  .bea-ft__acc details { border: 0; }
  .bea-ft__acc summary {
    list-style: none; cursor: pointer;
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 2px;
    font-family: "Inter", sans-serif;
    font-size: 13px; font-weight: 500;
    letter-spacing: -0.03em; text-transform: uppercase; color: #121212;
  }
  .bea-ft__acc summary::-webkit-details-marker { display: none; }
  .bea-ft__acc summary .bea-ft__pm { position: relative; width: 12px; height: 12px; flex: 0 0 12px; }
  .bea-ft__acc summary .bea-ft__pm::before,
  .bea-ft__acc summary .bea-ft__pm::after {
    content: ""; position: absolute; background: #121212;
    top: 50%; left: 50%; transform: translate(-50%,-50%);
  }
  .bea-ft__acc summary .bea-ft__pm::before { width: 12px; height: 1.5px; }
  .bea-ft__acc summary .bea-ft__pm::after { width: 1.5px; height: 12px; transition: opacity .2s ease; }
  .bea-ft__acc details[open] summary .bea-ft__pm::after { opacity: 0; }
  .bea-ft__acc ul { list-style: none; margin: 0; padding: 0 2px 18px; }
  .bea-ft__acc ul li { margin: 0 0 10px; }
  .bea-ft__acc ul a {
    font-size: 12px; color: rgba(18,18,18,.7); text-decoration: none;
    letter-spacing: -0.03em;
  }
  .bea-ft__acc ul a:hover { color: #121212; }

  /* Idioma / país */
  .bea-ft__loc {
    display: flex; align-items: center; gap: 10px;
    margin: 32px 0 26px; font-size: 11px; letter-spacing: -0.03em;
  }
  .bea-ft__loc .bea-loc { margin-left: auto; }
  .bea-ft__loc-label { font-weight: 500; text-transform: none; }
  .bea-ft__loc localization-form, .bea-ft__loc form { margin: 0; }
  .bea-ft__loc .disclosure__button,
  .bea-ft__loc .localization-selector {
    font-size: 12px; letter-spacing: -0.03em; color: #121212;
  }

  /* Copyright */
  .bea-ft__copy { font-size: 10px; letter-spacing: -0.03em; color: #121212; line-height: 1.4; }
  .bea-ft__copy .bea-ft__dev { color: #c2c2c2; font-size: 8px; display: block; }
  a.bea-ft__dev { text-decoration: none; }
  .bea-ft__nl-title { display: none; }

  @media screen and (min-width: 750px) {
    .bea-ft__inner { max-width: 520px; }
  }

{%- endstyle -%}

<div class="bea-ft color-{{ section.settings.color_scheme }}">
  {%- if section.settings.pill_text != blank -%}
    <div class="bea-ft__pill-wrap">
      <a class="bea-ft__pill" href="{{ section.settings.pill_link | default: '#' }}">{{ section.settings.pill_text }}</a>
    </div>
  {%- endif -%}

  <div class="bea-ft__inner">
    {%- if section.settings.logo != blank -%}
      <div class="bea-ft__logo">
        <a href="{{ routes.root_url }}">{{ section.settings.logo | image_url: height: 200 | image_tag: alt: shop.name, loading: 'lazy' }}</a>
      </div>
    {%- endif -%}

    {%- if section.settings.show_newsletter -%}
      {%- if section.settings.newsletter_label != blank or section.settings.newsletter_title != blank -%}
        <p class="bea-ft__nl-label">
          {%- if section.settings.newsletter_title != blank -%}<span class="bea-ft__nl-title">{{ section.settings.newsletter_title }}</span>{%- endif -%}
          {{ section.settings.newsletter_label }}
        </p>
      {%- endif -%}
      {%- assign bea_ph = 'newsletter.label' | t | default: 'Mail address' -%}
      {%- if section.settings.email_placeholder != blank -%}{%- assign bea_ph = section.settings.email_placeholder -%}{%- endif -%}
      {%- form 'customer', class: 'bea-ft__nl' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          type="email"
          name="contact[email]"
          placeholder="{{ bea_ph | escape }}"
          required
          autocorrect="off"
          autocapitalize="off"
          aria-label="Email"
        >
        <button type="submit" aria-label="{{ 'newsletter.button_label' | t | default: 'Subscribe' }}">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 12h15m0 0l-6-6m6 6l-6 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        {%- if form.posted_successfully? -%}
          <p class="bea-ft__nl-msg">{{ 'newsletter.success' | t | default: 'Thanks for subscribing' }}</p>
        {%- elsif form.errors -%}
          <p class="bea-ft__nl-msg">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    {%- assign social_blocks = section.blocks | where: 'type', 'social' -%}
    {%- if social_blocks.size > 0 -%}
      <div class="bea-ft__social">
        {%- for block in social_blocks -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" target="_blank" rel="noopener" aria-label="{{ block.settings.network }}" {{ block.shopify_attributes }}>
              {%- case block.settings.network -%}
                {%- when 'instagram' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
                {%- when 'youtube' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2.5" y="5.5" width="19" height="13" rx="4" stroke="currentColor" stroke-width="1.4"/><path d="M10 9.5l5 2.5-5 2.5z" fill="currentColor"/></svg>
                {%- when 'tiktok' -%}
                  <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M16.5 3c.3 1.9 1.4 3.4 3.5 3.7v2.5c-1.3.1-2.5-.3-3.5-1v5.6c0 3.2-2.4 5.2-5.2 4.9-2.6-.3-4.1-2.5-3.7-4.9.4-2.2 2.4-3.6 4.7-3.3v2.6c-.4-.1-.9-.2-1.4 0-.9.3-1.3 1.2-1 2.1.3.9 1.4 1.3 2.3.8.6-.3.9-.9.9-1.7V3z"/></svg>
                {%- when 'facebook' -%}
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14 8h2V5h-2c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h2l1-3h-3V8.5c0-.3.2-.5.5-.5z" fill="currentColor"/></svg>
                {%- when 'x' -%}
                  <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M17 3h3l-6.5 7.4L21 21h-5.6l-4-5.3L6.5 21H3.5l7-8L3 3h5.7l3.7 4.9zM15.9 19.2h1.5L8 4.7H6.4z"/></svg>
              {%- endcase -%}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign menu_blocks = section.blocks | where: 'type', 'menu' -%}
    {%- if menu_blocks.size > 0 -%}
      <div class="bea-ft__acc">
        {%- for block in menu_blocks -%}
          <details {{ block.shopify_attributes }}>
            <summary>
              <span>{{ block.settings.heading }}</span>
              <span class="bea-ft__pm" aria-hidden="true"></span>
            </summary>
            {%- if block.settings.menu != blank -%}
              <ul>
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_locale and localization.available_countries.size > 0 -%}
      <div class="bea-ft__loc">
        <span class="bea-ft__loc-label">{{ section.settings.locale_label }}</span>
        {%- render 'bea-footer-localization' -%}
      </div>
    {%- endif -%}

    <div class="bea-ft__copy">
      &copy; {{ 'now' | date: '%Y' }}, {{ section.settings.copyright_text | default: shop.name }}
      {%- if section.settings.developed_by != blank -%}
        {%- if section.settings.developed_by_link != blank -%}
          <a class="bea-ft__dev" href="{{ section.settings.developed_by_link }}" target="_blank" rel="noopener">{{ section.settings.developed_by }}</a>
        {%- else -%}
          <span class="bea-ft__dev">{{ section.settings.developed_by }}</span>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "BEALGND · Footer",
  "tag": "section",
  "class": "bea-ft-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#f9f9f9"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "top_spacing",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Espacio superior",
      "default": 40
    },
    {
      "type": "header",
      "content": "Pill superior"
    },
    {
      "type": "text",
      "id": "pill_text",
      "label": "Texto",
      "default": "To Make a Return"
    },
    {
      "type": "url",
      "id": "pill_link",
      "label": "Enlace"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (negro)"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 24,
      "max": 90,
      "step": 2,
      "unit": "px",
      "label": "Altura del logo",
      "default": 44
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Mostrar newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_label",
      "label": "Texto",
      "default": "Sign up and get -15% on your next order"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Título (solo ordenador)",
      "default": "Newsletter"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Texto del campo de email",
      "default": "Email"
    },
    {
      "type": "header",
      "content": "Idioma / país"
    },
    {
      "type": "checkbox",
      "id": "show_locale",
      "label": "Mostrar selector de país/idioma",
      "default": true
    },
    {
      "type": "text",
      "id": "locale_label",
      "label": "Etiqueta",
      "default": "Language:"
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Nombre en el copyright",
      "info": "Vacío = nombre de la tienda"
    },
    {
      "type": "text",
      "id": "developed_by",
      "label": "Línea inferior",
      "default": "developed by 141’Digital"
    },
    {
      "type": "url",
      "id": "developed_by_link",
      "label": "Enlace de «developed by»"
    }
  ],
  "blocks": [
    {
      "type": "social",
      "name": "Red social",
      "settings": [
        {
          "type": "select",
          "id": "network",
          "label": "Red",
          "default": "instagram",
          "options": [
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "youtube",
              "label": "YouTube"
            },
            {
              "value": "tiktok",
              "label": "TikTok"
            },
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "x",
              "label": "X (Twitter)"
            }
          ]
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menú desplegable",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "CUSTOMER SERVICE"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menú"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BEALGND · Footer",
      "blocks": [
        {
          "type": "social",
          "settings": {
            "network": "instagram"
          }
        },
        {
          "type": "social",
          "settings": {
            "network": "youtube"
          }
        },
        {
          "type": "social",
          "settings": {
            "network": "tiktok"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "CUSTOMER SERVICE"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "ABOUT BEALGND"
          }
        }
      ]
    }
  ]
}
{% endschema %}
