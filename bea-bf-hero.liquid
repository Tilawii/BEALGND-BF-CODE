{%- comment -%}
  BEALGND · Black Friday Early Access · Hero con formulario (Klaviyo)
  - Envía el email a la lista de Klaviyo indicada (API de cliente, clave pública).
  - Al apuntarse añade la clase "bf-joined" a <html>: se ocultan las secciones de la landing
    y se muestra la sección "BF · Confirmación". Para revisarla: añadir ?joined=1 a la URL.
  - También adapta el pie en esta página (oculta el -10 % y lo reorganiza en escritorio).
{%- endcomment -%}

{%- liquid
  assign bf_font = settings.type_body_font
  assign f500 = bf_font | font_modify: 'weight', '500'
  assign f600 = bf_font | font_modify: 'weight', '600'
  assign f700 = bf_font | font_modify: 'weight', '700'
  assign f900 = bf_font | font_modify: 'weight', '900'
-%}

<style>
  {% if f500 %}{{ f500 | font_face: font_display: 'swap' }}{% endif %}
  {% if f600 %}{{ f600 | font_face: font_display: 'swap' }}{% endif %}
  {% if f700 %}{{ f700 | font_face: font_display: 'swap' }}{% endif %}
  {% if f900 %}{{ f900 | font_face: font_display: 'swap' }}{% endif %}

  :root { --bf-red: #E8262B; --bf-green: #218519; --bf-ink: #121212; }
  .bea-bf, .bea-bf * { box-sizing: border-box; }
  .bea-bf { font-family: var(--font-body-family); color: var(--bf-ink); letter-spacing: 0; }
  .bea-bf a { text-decoration: none; }
  html.bf-joined .bea-bf-landing { display: none !important; }

  /* ---------- HERO ---------- */
  .bea-bf-hero { position: relative; background: #000; color: #fff; overflow: hidden; margin-top: 14px; }
  .bea-bf-hero__media { position: absolute; inset: 0 0 auto 0; height: 520px; }
  .bea-bf-hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: {{ section.settings.image_position_mobile }}; display: block; }
  .bea-bf-hero .bea-bf-hero__shade { display: block; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,.35) 0%, rgba(0,0,0,.05) 28%, rgba(0,0,0,.92) 62%, #000 100%); }
  .bea-bf-hero__inner { position: relative; min-height: 760px; display: flex; flex-direction: column; justify-content: space-between; padding: 20px 20px 28px; }
  .bea-bf-chip { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px 8px 12px; border-radius: 40px;
    background: rgba(255,255,255,.10); border: 1px solid rgba(255,255,255,.18); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    font-size: 10px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: #fff; align-self: flex-start; line-height: 1.2; }
  .bea-bf-chip__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--bf-red); flex: none; }
  .bea-bf-hero__content { display: flex; flex-direction: column; gap: 18px; width: 100%; max-width: 580px; }
  .bea-bf-title { margin: 0; color: #fff; font-family: var(--font-body-family); }
  .bea-bf-title__up { display: block; font-size: 15px; font-weight: 700; letter-spacing: .30em; line-height: 1.2; }
  .bea-bf-title__big { display: block; font-size: 168px; font-weight: 900; line-height: .82; letter-spacing: -.07em; margin-left: -6px; }
  .bea-bf-title__row { display: flex; align-items: center; gap: 10px; padding-top: 6px; font-size: 30px; line-height: 1.2; letter-spacing: -.02em; white-space: nowrap; }
  .bea-bf-title__off { font-weight: 900; }
  .bea-bf-title__line { width: 28px; height: 2px; background: var(--bf-red); flex: none; }
  .bea-bf-title__rest { font-weight: 500; opacity: .6; }
  .bea-bf-sub { margin: 0; font-size: 14px; line-height: 1.4; color: rgba(255,255,255,.75); }

  .bea-bf-cd { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .bea-bf-cd__box { display: flex; flex-direction: column; align-items: center; padding: 10px 0 9px; border-radius: 12px;
    background: rgba(255,255,255,.10); border: 1px solid rgba(255,255,255,.18); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); }
  .bea-bf-cd__num { font-size: 24px; font-weight: 700; letter-spacing: -.02em; line-height: 1.2; font-variant-numeric: tabular-nums; }
  .bea-bf-cd__lab { font-size: 10px; font-weight: 500; opacity: .55; line-height: 1.2; }

  .bea-bf-form { display: flex; flex-direction: column; gap: 10px; }
  .bea-bf-pill { display: flex; align-items: center; justify-content: space-between; gap: 8px; background: #fff; border-radius: 40px; padding: 6px 6px 6px 20px; }
  .bea-bf-pill input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: inherit; font-size: 14px; color: var(--bf-ink); padding: 0; box-shadow: none; }
  .bea-bf-pill input::placeholder { color: #8C8C8C; opacity: 1; }
  .bea-bf-btn { display: inline-flex; align-items: center; gap: 8px; border: 0; cursor: pointer; background: #000; color: #fff; border-radius: 40px;
    padding: 14px 18px; font: inherit; font-size: 13px; font-weight: 600; line-height: 1.2; white-space: nowrap; }
  .bea-bf-btn[disabled] { opacity: .6; cursor: default; }
  .bea-bf-micro { margin: 0; font-size: 11px; line-height: 1.3; color: rgba(255,255,255,.5); text-align: center; }
  .bea-bf-error { margin: 0; font-size: 12px; color: #FF8A8A; display: none; text-align: center; }
  .bea-bf-error.is-visible { display: block; }

  @media screen and (min-width: 990px) {
    .bea-bf-hero { margin-top: 0; }
    .bea-bf-hero__media { inset: 0 0 0 auto; height: 100%; width: 69.5%; }
    .bea-bf-hero__media img { object-position: {{ section.settings.image_position_desktop }}; }
    .bea-bf-hero .bea-bf-hero__shade { display: block; background: linear-gradient(90deg, #000 0%, #000 38%, rgba(0,0,0,.35) 62%, rgba(0,0,0,.10) 100%); }
    .bea-bf-hero__inner { min-height: 760px; max-width: 1440px; margin: 0 auto; padding: 0 120px; justify-content: center; gap: 22px; }
    .bea-bf-hero__content { gap: 22px; }
    .bea-bf-chip { font-size: 11px; }
    .bea-bf-title__up { font-size: 18px; }
    .bea-bf-title__big { font-size: 240px; margin-left: -9px; }
    .bea-bf-title__row { gap: 14px; padding-top: 8px; font-size: 44px; }
    .bea-bf-title__line { width: 40px; height: 3px; }
    .bea-bf-sub { font-size: 18px; }
    .bea-bf-cd { gap: 8px; }
    .bea-bf-cd__box { padding: 12px 0 11px; border-radius: 14px; }
    .bea-bf-cd__num { font-size: 30px; }
    .bea-bf-cd__lab { font-size: 11px; }
    .bea-bf-pill { padding: 7px 7px 7px 24px; }
    .bea-bf-pill input { font-size: 16px; }
    .bea-bf-btn { padding: 16px 24px; font-size: 15px; }
    .bea-bf-micro { font-size: 12px; text-align: left; }
    .bea-bf-error { text-align: left; }
  }

  {%- if section.settings.footer_adapt -%}
  /* ---------- PIE (solo en esta página) ---------- */
  .bea-ft__nl-label, .bea-ft__nl { display: none !important; }
  @media screen and (min-width: 990px) {
    .bea-ft__inner { max-width: 1100px !important; width: 100%; margin: 0 auto;
      display: grid !important; grid-template-columns: 1fr auto auto; column-gap: 96px; row-gap: 28px; align-items: start;
      padding-top: 64px; padding-bottom: 32px; text-align: left; }
    .bea-ft__logo { grid-column: 1; grid-row: 1; justify-self: start; margin: 0 !important; }
    .bea-ft__social { grid-column: 1; grid-row: 2; justify-content: flex-start !important; gap: 28px !important; margin: 0 !important; }
    .bea-ft__acc { grid-column: 2; grid-row: 1 / span 2; display: flex !important; gap: 96px; margin: 0 !important; border: 0 !important; }
    .bea-ft__acc details { border: 0 !important; min-width: 0; }
    .bea-ft__acc summary { pointer-events: none; padding: 0 0 16px !important; border: 0 !important; }
    .bea-ft__acc .bea-ft__pm { display: none !important; }
    .bea-ft__acc ul { display: flex !important; flex-direction: column; gap: 16px; padding: 0 !important; margin: 0 !important; } .bea-ft__acc li { margin: 0 !important; padding: 0 !important; }
    .bea-ft__loc { grid-column: 3; grid-row: 1 / span 2; display: flex !important; flex-direction: column; align-items: flex-start !important; gap: 16px; margin: 0 !important; }
    .bea-ft__loc-label { font-size: 13px !important; text-transform: uppercase; }
    .bea-ft__copy { grid-column: 1 / -1; display: flex !important; justify-content: space-between; align-items: center; border-top: 1px solid rgba(18,18,18,.1); padding-top: 32px; margin-top: 20px; } .bea-ft__dev { width: auto !important; display: inline !important; font-size: 11px !important; }
  }
  {%- endif -%}
</style>

<section class="bea-bf bea-bf-landing bea-bf-hero" id="bf-hero-{{ section.id }}"
  data-bf-hero
  data-company="{{ section.settings.klaviyo_public_key | escape }}"
  data-list="{{ section.settings.klaviyo_list_id | escape }}"
  data-source="{{ section.settings.klaviyo_source | escape }}">
  <div class="bea-bf-hero__media">
    {%- if section.settings.image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 989px)" srcset="{{ section.settings.image_mobile | image_url: width: 800 }} 800w, {{ section.settings.image_mobile | image_url: width: 1200 }} 1200w">
        {%- endif -%}
        {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 70vw, 100vw', widths: '600, 900, 1200, 1600, 2000', alt: section.settings.image.alt | escape }}
      </picture>
    {%- endif -%}
  </div>
  <div class="bea-bf-hero__shade" aria-hidden="true"></div>

  <div class="bea-bf-hero__inner">
    <div class="bea-bf-chip"><span class="bea-bf-chip__dot"></span>{{ section.settings.chip }}</div>

    <div class="bea-bf-hero__content">
      <h1 class="bea-bf-title">
        <span class="bea-bf-title__up">{{ section.settings.title_top }}</span>
        <span class="bea-bf-title__big">{{ section.settings.title_big }}</span>
        <span class="bea-bf-title__row">
          <span class="bea-bf-title__off">{{ section.settings.title_off }}</span>
          <span class="bea-bf-title__line" aria-hidden="true"></span>
          <span class="bea-bf-title__rest">{{ section.settings.title_rest }}</span>
        </span>
      </h1>
      <p class="bea-bf-sub">{{ section.settings.subtitle }}</p>

      <div class="bea-bf-cd" data-bf-countdown="{{ section.settings.countdown_end | escape }}" aria-label="{{ section.settings.cd_aria | escape }}">
        <div class="bea-bf-cd__box"><span class="bea-bf-cd__num" data-unit="d">00</span><span class="bea-bf-cd__lab">{{ section.settings.cd_days }}</span></div>
        <div class="bea-bf-cd__box"><span class="bea-bf-cd__num" data-unit="h">00</span><span class="bea-bf-cd__lab">{{ section.settings.cd_hours }}</span></div>
        <div class="bea-bf-cd__box"><span class="bea-bf-cd__num" data-unit="m">00</span><span class="bea-bf-cd__lab">{{ section.settings.cd_minutes }}</span></div>
        <div class="bea-bf-cd__box"><span class="bea-bf-cd__num" data-unit="s">00</span><span class="bea-bf-cd__lab">{{ section.settings.cd_seconds }}</span></div>
      </div>

      <form class="bea-bf-form" data-bf-form novalidate>
        <div class="bea-bf-pill">
          <label class="visually-hidden" for="bf-email-{{ section.id }}">{{ section.settings.placeholder }}</label>
          <input id="bf-email-{{ section.id }}" type="email" name="email" autocomplete="email" inputmode="email" required placeholder="{{ section.settings.placeholder | escape }}">
          <button type="submit" class="bea-bf-btn" data-bf-submit>
            <span data-bf-label>{{ section.settings.button }}</span><span aria-hidden="true">→</span>
          </button>
        </div>
        <p class="bea-bf-error" data-bf-error role="alert">{{ section.settings.error_text }}</p>
        <p class="bea-bf-micro">{{ section.settings.micro }}</p>
      </form>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('bf-hero-{{ section.id }}');
    if (!root || root.dataset.bfReady) return;
    root.dataset.bfReady = '1';

    /* Cuenta atrás (todas las de la página) */
    function pad(n) { return (n < 10 ? '0' : '') + n; }
    function tick() {
      document.querySelectorAll('[data-bf-countdown]').forEach(function (el) {
        var end = Date.parse(el.getAttribute('data-bf-countdown'));
        if (isNaN(end)) return;
        var diff = Math.max(0, Math.floor((end - Date.now()) / 1000));
        var v = { d: Math.floor(diff / 86400), h: Math.floor(diff % 86400 / 3600), m: Math.floor(diff % 3600 / 60), s: diff % 60 };
        el.querySelectorAll('[data-unit]').forEach(function (n) { n.textContent = pad(v[n.getAttribute('data-unit')]); });
      });
    }
    tick(); setInterval(tick, 1000);

    /* Confirmación */
    function showJoined(scroll) {
      document.documentElement.classList.add('bf-joined');
      if (scroll) window.scrollTo({ top: 0, behavior: 'instant' in document.documentElement.style ? 'instant' : 'auto' });
    }
    if (/[?&]joined=1/.test(location.search)) showJoined(false);

    /* Formulario → Klaviyo */
    var form = root.querySelector('[data-bf-form]');
    var input = form.querySelector('input[type=email]');
    var btn = form.querySelector('[data-bf-submit]');
    var label = form.querySelector('[data-bf-label]');
    var err = form.querySelector('[data-bf-error]');
    var idle = label.textContent;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      err.classList.remove('is-visible');
      var email = (input.value || '').trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { err.classList.add('is-visible'); input.focus(); return; }
      btn.disabled = true; label.textContent = {{ section.settings.button_loading | json }};
      var body = { data: { type: 'subscription', attributes: {
        custom_source: root.dataset.source || 'BF Early Access landing',
        profile: { data: { type: 'profile', attributes: {
          email: email
        } } }
      }, relationships: { list: { data: { type: 'list', id: root.dataset.list } } } } };
      fetch('https://a.klaviyo.com/client/subscriptions/?company_id=' + encodeURIComponent(root.dataset.company), {
        method: 'POST',
        headers: { 'Content-Type': 'application/vnd.api+json', 'Accept': 'application/vnd.api+json', 'revision': '2024-10-15' },
        body: JSON.stringify(body)
      }).then(function (r) {
        if (!r.ok) { return r.text().then(function (t) { console.warn('[BF] Klaviyo', r.status, t); throw new Error('Klaviyo ' + r.status); }); }
        try { if (window.klaviyo && window.klaviyo.identify) window.klaviyo.identify({ email: email }); } catch (x) {}
        try { localStorage.setItem('bf_ea_2026_joined', '1'); } catch (x) {}
        showJoined(true);
      }).catch(function () {
        err.classList.add('is-visible');
      }).finally(function () {
        btn.disabled = false; label.textContent = idle;
      });
    });
  })();
</script>

{%- if section.settings.footer_adapt -%}<script>(function(){var mq=window.matchMedia('(min-width: 990px)');function o(){document.querySelectorAll('.bea-ft__acc details').forEach(function(d){if(mq.matches){d.setAttribute('open','');}});}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',o);}else{o();}if(mq.addEventListener){mq.addEventListener('change',o);}})();</script>{%- endif -%}{% schema %}
{
  "name": "BF · Hero + formulario",
  "tag": "div",
  "class": "bea-bf-hero-section",
  "settings": [
    { "type": "header", "content": "Imagen" },
    { "type": "image_picker", "id": "image", "label": "Foto" },
    { "type": "image_picker", "id": "image_mobile", "label": "Foto en móvil (opcional)" },
    { "type": "text", "id": "image_position_mobile", "label": "Encuadre en móvil (CSS object-position)", "default": "30% 60%" },
    { "type": "text", "id": "image_position_desktop", "label": "Encuadre en escritorio (CSS object-position)", "default": "40% 60%" },
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "chip", "label": "Etiqueta", "default": "Black Friday 2026 · Early Access" },
    { "type": "text", "id": "title_top", "label": "Titular · línea pequeña", "default": "UP TO" },
    { "type": "text", "id": "title_big", "label": "Titular · número grande", "default": "70%" },
    { "type": "text", "id": "title_off", "label": "Titular · palabra en negrita", "default": "OFF" },
    { "type": "text", "id": "title_rest", "label": "Titular · resto", "default": "before everyone" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Black Friday opens on 11 November, only for the VIP list." },
    { "type": "header", "content": "Cuenta atrás" },
    { "type": "text", "id": "countdown_end", "label": "Fecha y hora de inicio (ISO, hora de Madrid)", "default": "2026-11-11T00:00:00+01:00", "info": "Formato AAAA-MM-DDTHH:MM:SS+01:00" },
    { "type": "text", "id": "cd_days", "label": "Días", "default": "days" },
    { "type": "text", "id": "cd_hours", "label": "Horas", "default": "hrs" },
    { "type": "text", "id": "cd_minutes", "label": "Minutos", "default": "min" },
    { "type": "text", "id": "cd_seconds", "label": "Segundos", "default": "sec" },
    { "type": "text", "id": "cd_aria", "label": "Texto accesible", "default": "Early access opens in" },
    { "type": "header", "content": "Formulario" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Your email" },
    { "type": "text", "id": "button", "label": "Botón", "default": "Get early access" },
    { "type": "text", "id": "button_loading", "label": "Botón · enviando", "default": "Joining…" },
    { "type": "text", "id": "micro", "label": "Texto bajo el formulario", "default": "Free to join · Unsubscribe anytime" },
    { "type": "text", "id": "error_text", "label": "Texto de error", "default": "Please enter a valid email and try again." },
    { "type": "header", "content": "Klaviyo" },
    { "type": "text", "id": "klaviyo_public_key", "label": "Clave pública (Site ID)", "default": "SGSY9s" },
    { "type": "text", "id": "klaviyo_list_id", "label": "ID de la lista", "default": "UyN2fx" },
    { "type": "text", "id": "klaviyo_source", "label": "Origen del alta", "default": "BF Early Access landing" },
    { "type": "header", "content": "Pie de página" },
    { "type": "checkbox", "id": "footer_adapt", "label": "Ocultar el -10 % del pie y adaptarlo a escritorio en esta página", "default": true }
  ],
  "presets": [{ "name": "BF · Hero + formulario" }]
}
{% endschema %}
