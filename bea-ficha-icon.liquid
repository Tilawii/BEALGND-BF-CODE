{%- comment -%}
bea-ficha-icon.liquid · BEALGND · Ficha nueva (nov 2026)
Iconos de las ventajas. Uso: {%- render 'bea-ficha-icon', key: 'correa' -%}
Claves (las mismas que el desplegable del formulario «Ficha de producto»):
compartimento, zapatero, cremallera, asas, correa, etiqueta, logo, portatil, iman, material
{%- endcomment -%}
{%- comment -%} BEA · 17 nov: si Translate & Adapt traduce la clave del icono (FR/EN), se vuelve a la clave original {%- endcomment -%}
{%- liquid
  assign key = key | downcase | strip
  case key
    when 'compartiment', 'compartment', 'compartiment principal'
      assign key = 'compartimento'
    when 'range-chaussures', 'compartiment à chaussures', 'chaussures', 'shoe compartment', 'shoes', 'cordonnier', 'zapatos'
      assign key = 'zapatero'
    when 'fermeture éclair', 'fermeture eclair', 'zip', 'zipper', 'fermeture à glissière'
      assign key = 'cremallera'
    when 'poignées', 'poignees', 'anses', 'handles', 'asa', 'ailes'
      assign key = 'asas'
    when 'sangle', 'bandoulière', 'bandouliere', 'strap', 'courroie'
      assign key = 'correa'
    when 'étiquette', 'etiquette', 'label', 'tag'
      assign key = 'etiqueta'
    when 'ordinateur portable', 'portable', 'laptop', 'portátil'
      assign key = 'portatil'
    when 'aimant', 'magnet', 'imán'
      assign key = 'iman'
    when 'logotipo', 'logotype'
      assign key = 'logo'
    when 'retour', 'retours', 'return', 'returns', 'devolución'
      assign key = 'devolucion'
    when 'mesures', 'dimensions', 'measurements'
      assign key = 'medidas'
    when 'matériel', 'materiel', 'matériau', 'materiau', 'matière', 'matiere'
      assign key = 'material'
  endcase
-%}
<svg class="bea-fi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- case key -%}
{%- when 'zapatero' -%}<path d="M3 15.5V10l4 1.5 3-3 2.5 1 1 2.5 6 1.5c1.2.3 1.5 1.2 1.5 2v1H3z"/><path d="M3 18.5h18"/>
{%- when 'cremallera' -%}<path d="M4 12h16"/><path d="M6 10.5v3M8.5 10.5v3M11 10.5v3M13.5 10.5v3"/><rect x="15.5" y="9.5" width="4" height="5" rx="1"/><path d="M17.5 14.5v3"/>
{%- when 'asas' -%}<path d="M8 9V7a4 4 0 0 1 8 0v2"/><rect x="4" y="9" width="16" height="11" rx="2"/>
{%- when 'correa' -%}<path d="M5 20C5 11 9 4 12 4s7 7 7 16"/><rect x="3.5" y="18" width="3" height="3" rx=".5"/><rect x="17.5" y="18" width="3" height="3" rx=".5"/>
{%- when 'etiqueta' -%}<path d="M4 4h8l8 8-8 8-8-8z"/><circle cx="8.5" cy="8.5" r="1.3"/>
{%- when 'logo' -%}<circle cx="12" cy="12" r="8"/><path d="M12 7.5l1.3 3h3.2l-2.6 1.9 1 3.1-2.9-2-2.9 2 1-3.1-2.6-1.9h3.2z"/>
{%- when 'portatil' -%}<rect x="5" y="5" width="14" height="10" rx="1"/><path d="M3 18.5h18l-1.5-3.5h-15z"/>
{%- when 'iman' -%}<path d="M6 4v8a6 6 0 0 0 12 0V4h-4v8a2 2 0 0 1-4 0V4z"/><path d="M6 7.5h4M14 7.5h4"/>
{%- when 'devolucion' -%}<path d="M9 7H4V2"/><path d="M4.6 7A8.5 8.5 0 1 1 3.5 12"/>
{%- when 'medidas' -%}<path d="M3 9h18v6H3z"/><path d="M7 9v3M11 9v2M15 9v3M19 9v2"/>
{%- when 'material' -%}<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M4 9h16M4 14h16M9 4v16M14 4v16"/>
{%- else -%}<rect x="3.5" y="7" width="17" height="12" rx="2"/><path d="M3.5 11h17"/><path d="M9 7V5.5h6V7"/>
{%- endcase -%}
</svg>
