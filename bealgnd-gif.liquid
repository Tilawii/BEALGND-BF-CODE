{%- comment -%}
  BEALGND · Imágenes en bucle (tipo GIF)
  Una imagen grande que va cambiando de golpe cada X segundos.
  Cada bloque = una imagen. Sin texto.
{%- endcomment -%}

{%- style -%}
  bea-gif {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: var(--bea-gif-ratio, 1 / 1);
    overflow: hidden;
    background: #1a1a1a;
  }
  .bea-gif__frame {
    position: absolute; inset: 0;
    opacity: 0;
    visibility: hidden;
  }
  .bea-gif__frame.is-active {
    opacity: 1;
    visibility: visible;
  }
  .bea-gif__frame img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
  }
  .bea-gif__placeholder {
    position: absolute; inset: 0;
    display: flex; align-items: flex-end; justify-content: center;
    padding-bottom: 16px;
    background: #1a1a1a;
    color: rgba(255,255,255,.4);
  }
  .bea-gif__placeholder span {
    font-family: var(--font-body-family);
    font-size: 13px; letter-spacing: .02em;
  }
{%- endstyle -%}

<bea-gif
  style="--bea-gif-ratio: {{ section.settings.ratio }};"
  data-speed="{{ section.settings.speed }}"
>
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div class="bea-gif__frame{% if forloop.first %} is-active{% endif %}" data-frame {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 2000
            | image_tag:
              loading: forloop.first,
              sizes: '100vw',
              widths: '360,540,720,900,1200,1600,2000'
          }}
        {%- else -%}
          <div class="bea-gif__placeholder"><span>Imagen</span></div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  {%- else -%}
    <div class="bea-gif__placeholder"><span>Añade imágenes</span></div>
  {%- endif -%}
</bea-gif>

<script>
  if (!customElements.get('bea-gif')) {
    customElements.define('bea-gif', class extends HTMLElement {
      connectedCallback() {
        this.frames = Array.prototype.slice.call(this.querySelectorAll('[data-frame]'));
        if (this.frames.length < 2) return;
        var speed = (parseFloat(this.dataset.speed || '2')) * 1000;
        var self = this;
        this.i = 0;
        this.stop();
        this._iv = setInterval(function () {
          self.frames[self.i].classList.remove('is-active');
          self.i = (self.i + 1) % self.frames.length;
          self.frames[self.i].classList.add('is-active');
        }, speed);
        // pausar si la pestaña no está visible
        this._vis = function () { if (document.hidden) self.stop(); };
        document.addEventListener('visibilitychange', this._vis);
      }
      disconnectedCallback() { this.stop(); }
      stop() { if (this._iv) { clearInterval(this._iv); this._iv = null; } }
    });
  }
</script>

{% schema %}
{
  "name": "BEALGND · GIF",
  "tag": "section",
  "class": "bea-gif-section",
  "settings": [
    { "type": "range", "id": "speed", "min": 0.5, "max": 5, "step": 0.5, "unit": "s", "label": "Segundos por imagen", "default": 2 },
    {
      "type": "select",
      "id": "ratio",
      "label": "Proporción",
      "default": "1 / 1",
      "options": [
        { "value": "1 / 1", "label": "Cuadrado (1:1)" },
        { "value": "4 / 5", "label": "Vertical (4:5)" },
        { "value": "16 / 9", "label": "Horizontal (16:9)" },
        { "value": "3 / 4", "label": "Vertical (3:4)" },
        { "value": "2 / 1", "label": "Panorámico (2:1)" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Imagen",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "BEALGND · GIF",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
