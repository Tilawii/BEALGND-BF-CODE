{% comment %}
  Renders cart drawer

  Usage:
  {% render 'cart-drawer' %}

  i18n (BEALGND): los textos fijos usan claves bealgnd.cart.* (locales/en.default.json), traducibles en
  Translate & Adapt > "Contenido del tema predeterminado" (buscar "bealgnd"). Las claves *_html llevan <b>
  dentro: al traducir, mantener las etiquetas <b>...</b>.
  Los fetch que re-renderizan el cajon (?section_id=...) usan la raiz localizada para que vuelvan traducidos.
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'bealgnd-cart.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer {
    visibility: hidden;
  }
</style>

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner gradient color-{{ settings.cart_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      {%- if cart == empty -%}
        <div class="drawer__inner-empty">
          <div class="cart-drawer__warnings center{% if settings.cart_drawer_collection != blank %} cart-drawer__warnings--has-collection{% endif %}">
            <div class="cart-drawer__empty-content">
              <h2 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h2>
              <button
                class="drawer__close"
                type="button"
                onclick="this.closest('cart-drawer').close()"
                aria-label="{{ 'accessibility.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
              <a href="{{ routes.all_products_collection_url }}" class="button">
                {{ 'general.continue_shopping' | t }}
              </a>

              {%- if shop.customer_accounts_enabled and customer == null -%}
                <p class="cart__login-title h3">{{ 'sections.cart.login.title' | t }}</p>
                <p class="cart__login-paragraph">
                  {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
                </p>
              {%- endif -%}
            </div>
          </div>
          {%- if settings.cart_drawer_collection != blank -%}
            <div class="cart-drawer__collection">
              {% render 'card-collection', card_collection: settings.cart_drawer_collection, columns: 1 %}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="drawer__header">
        <h2 class="drawer__heading">{{ 'sections.cart.title' | t }}<span class="drawer__heading--small">{{ cart.item_count }}</span></h2>
        <button
          class="drawer__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>
      {%- unless cart == empty -%}
        {%- liquid
          assign ship_threshold = settings.free_shipping_threshold | default: 120 | times: 100
          assign ship_done = false
          if cart.total_price >= ship_threshold
            assign ship_done = true
          endif
          assign gift_done = false
          if cart.total_discount > 0
            assign gift_done = true
          endif
          assign fill_pct = 0
          if gift_done
            assign fill_pct = 100
          elsif ship_done
            assign fill_pct = 50
          endif
        -%}
        <div class="bea-progress bea-progress--milestones{% if ship_done %} is-ship-done{% endif %}{% if gift_done %} is-gift-done{% endif %}"
          data-total="{{ cart.total_price }}"
          data-threshold="{{ ship_threshold }}"
          data-fill-target="{{ fill_pct }}"
          data-gift-unlocked="{% if gift_done %}1{% else %}0{% endif %}">
          <p class="bea-prog__msg">
            {%- if gift_done -%}{{ 'bealgnd.gi.progress_gift_in_cart_html' | t }}
            {%- elsif ship_done -%}{{ 'bealgnd.cart.progress_add_for_gift_html' | t }}
            {%- else -%}{{ 'bealgnd.cart.progress_shipping_unlocked_html' | t }}{%- endif -%}
          </p>
          <div class="bea-prog">
            <div class="bea-prog__track">
              <div class="bea-prog__fill" style="width:0%">&#8203;</div>
              <span class="bea-prog__dot bea-prog__dot--ship{% if ship_done %} is-done{% endif %}">
                {%- if ship_done -%}<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="rgba(18,18,18,.35)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>{%- endif -%}
              </span>
              <span class="bea-prog__dot bea-prog__dot--gift{% if gift_done %} is-done{% endif %}">
                {%- if gift_done -%}<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="rgba(18,18,18,.35)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>{%- endif -%}
              </span>
            </div>
            <div class="bea-prog__labels">
              <span class="bea-prog__lab bea-prog__lab--ship{% if ship_done %} is-done{% endif %}">{{ 'bealgnd.cart.label_free_shipping' | t }}</span>
              <span class="bea-prog__lab bea-prog__lab--gift{% if gift_done %} is-done{% endif %}">{{ 'bealgnd.cart.label_free_gift' | t }}</span>
            </div>
          </div>
        </div>
      {%- endunless -%}
      <cart-drawer-items
        view-event-payload="{{ cart | standard_event_data: 'view', context: 'dialog' | escape }}"
        view-event-trigger="manual"
        {% if cart == empty %}
          class=" is-empty"
        {% endif %}
      >
        <form
          action="{{ routes.cart_url }}"
          id="CartDrawer-Form"
          class="cart__contents cart-drawer__form"
          method="post"
        >
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {%- if cart != empty -%}
              <div class="drawer__cart-items-wrapper">
                <table class="cart-items" role="table">
                  <thead role="rowgroup">
                    <tr role="row">
                      <th id="CartDrawer-ColumnProductImage" role="columnheader">
                        <span class="visually-hidden">{{ 'sections.cart.headings.image' | t }}</span>
                      </th>
                      <th
                        id="CartDrawer-ColumnProduct"
                        class="caption-with-letter-spacing"
                        scope="col"
                        role="columnheader"
                      >
                        {{ 'sections.cart.headings.product' | t }}
                      </th>
                      <th
                        id="CartDrawer-ColumnTotal"
                        class="right caption-with-letter-spacing"
                        scope="col"
                        role="columnheader"
                      >
                        {{ 'sections.cart.headings.total' | t }}
                      </th>
                      <th id="CartDrawer-ColumnQuantity" role="columnheader">
                        <span class="visually-hidden">{{ 'sections.cart.headings.quantity' | t }}</span>
                      </th>
                    </tr>
                  </thead>

                  <tbody role="rowgroup">
                    {%- comment -%} BEA · Regalo incluido: los regalos (propiedad _bea_gift o linea a 0 €) se pintan justo debajo del primer bolso de la oferta {%- endcomment -%}
{%- liquid
  assign bea_o1_ids = ','
  for p in collections['bogo-oferta-1-compra'].products
    assign bea_o1_ids = bea_o1_ids | append: p.id | append: ','
  endfor
  assign bea_o2_ids = ','
  for p in collections['bogo-oferta-2-compra'].products
    assign bea_o2_ids = bea_o2_ids | append: p.id | append: ','
  endfor
  # Oferta activa igual que la Function: si hay un bolso de la oferta 1, manda la 1 (el resto pasa a ser 50 %)
  assign bea_buy_ids = bea_o2_ids
  for it in cart.items
    assign k = ',' | append: it.product_id | append: ','
    if bea_o1_ids contains k and it.final_line_price > 0
      assign bea_buy_ids = bea_o1_ids
      break
    endif
  endfor
  assign bea_gifts = ''
  assign bea_rest = ''
  assign bea_others = ''
  assign bea_first_buy = -1
  assign bea_first_price = 0
  for it in cart.items
    assign it_gift = false
    if it.properties._bea_gift != blank or it.properties._bea_gift_for != blank
      assign it_gift = true
    elsif it.final_line_price == 0 and it.original_line_price > 0
      assign it_gift = true
    endif
    if it_gift
      assign bea_gifts = bea_gifts | append: forloop.index0 | append: ','
    else
      assign k = ',' | append: it.product_id | append: ','
      if bea_buy_ids contains k
        assign bea_rest = bea_rest | append: forloop.index0 | append: ','
        # El bolso que manda (y al que se cuelga el regalo) es el mas caro, igual que en la Function
        if bea_first_buy == -1 or it.original_price > bea_first_price
          assign bea_first_buy = forloop.index0
          assign bea_first_price = it.original_price
        endif
      else
        assign bea_others = bea_others | append: forloop.index0 | append: ','
      endif
    endif
  endfor
  # Orden: bolso que manda -> su regalo -> resto de bolsos -> otros productos
  assign bea_order = ''
  if bea_first_buy > -1
    assign bea_order = bea_first_buy | append: ','
  endif
  assign bea_order = bea_order | append: bea_gifts
  assign rest_arr = bea_rest | split: ','
  for rr in rest_arr
    assign rn = rr | plus: 0
    if rn != bea_first_buy
      assign bea_order = bea_order | append: rr | append: ','
    endif
  endfor
  assign bea_order = bea_order | append: bea_others
  assign bea_idx = bea_order | split: ','
-%}
{%- for bea_i in bea_idx -%}
{%- liquid
  assign bea_n = bea_i | plus: 0
  assign item = cart.items[bea_n]
  assign bea_has_gprop = false
  if item.properties._bea_gift != blank or item.properties._bea_gift_for != blank
    assign bea_has_gprop = true
  endif
  assign bea_is_gift = false
  if item.final_line_price == 0 and item.original_line_price > 0
    assign bea_is_gift = true
  endif
  assign bea_pkey = ',' | append: item.product_id | append: ','
  assign bea_cmp = item.variant.compare_at_price | default: 0
  assign bea_is_buy = false
  if bea_buy_ids contains bea_pkey and bea_has_gprop == false and bea_is_gift == false
    assign bea_is_buy = true
  endif
-%}
                      <tr
                        id="CartDrawer-Item-{{ item.index | plus: 1 }}"
                        class="cart-item{% if item.parent_relationship.parent != null %} cart-item__nested-line{% endif %}{% if bea_is_gift %} cart-item--gift{% endif %}" data-variant-id="{{ item.variant_id }}" data-product-id="{{ item.product_id }}" data-handle="{{ item.product.handle }}" data-line-key="{{ item.key }}" data-qty="{{ item.quantity }}"{% if bea_has_gprop %} data-bea-gift{% endif %}{% if bea_is_buy %} data-buy{% endif %}
                        role="row"
                        {% if item.parent_relationship.parent != null %}
                          aria-label="{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}"
                        {% endif %}
                      >
                        <td
                          class="cart-item__media"
                          role="cell"
                          headers="CartDrawer-ColumnProductImage"
                        >
                          {% if item.image %}
                            {% comment %} Leave empty space due to a:empty CSS display: none rule {% endcomment %}
                            <a href="{{ item.url }}" class="cart-item__link" tabindex="-1" aria-hidden="true"> </a>
                            <img
                              class="cart-item__image"
                              src="{{ item.image | image_url: width: 300 }}"
                              alt="{{ item.image.alt | escape }}"
                              loading="lazy"
                              width="150"
                              height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                            >
                          {% endif %}
                        </td>

                        <td class="cart-item__details" role="cell" headers="CartDrawer-ColumnProduct">
                          {%- if settings.show_vendor -%}
                            <p class="caption-with-letter-spacing light">{{ item.product.vendor }}</p>
                          {%- endif -%}

                          <div class="cart-item__title">
                            <a href="{{ item.url }}" class="cart-item__name h4 break">
                              {{- item.product.title | escape -}}
                            </a>
                            {%- assign cart_disclosure_modal_id = 'CartDisclosureModal-drawer-' | append: item.key | replace: ':', '-' -%}
                            {%- render 'cart-disclosure-indicator',
                              product: item.product,
                              modal_id: cart_disclosure_modal_id
                            -%}
                          </div>

                          {%- if bea_is_gift -%}
<div class="cart-item__discounted-prices bea-gift-price"><s class="cart-item__old-price product-option">{{ item.original_price | money }}</s><span class="bea-tag bea-tag--cart"><svg viewBox="0 0 11 11" fill="none" stroke="#218519" stroke-width="1.125" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1.833 3.667h7.334c.253 0 .458.205.458.458v.917a.458.458 0 0 1-.458.458H1.833a.458.458 0 0 1-.458-.458v-.917c0-.253.205-.458.458-.458Z"/><path d="M5.5 3.667v5.958"/><path d="M8.708 5.5v3.208a.917.917 0 0 1-.916.917H3.208a.917.917 0 0 1-.916-.917V5.5"/><path d="M3.438 3.667a1.146 1.146 0 0 1 0-2.292C5.042 1.375 5.5 3.667 5.5 3.667s.458-2.292 2.063-2.292a1.146 1.146 0 0 1 0 2.292"/></svg>{{ 'bealgnd.gi.free_gift' | t }}</span>{%- if item.quantity > 1 -%}<span class="bea-gift-qty">× {{ item.quantity }}</span>{%- endif -%}</div>
{%- elsif item.original_price != item.final_price or bea_cmp > item.original_price -%}
                            <div class="cart-item__discounted-prices">
                              <span class="visually-hidden">
                                {{ 'products.product.price.regular_price' | t }}
                              </span>
                              <s class="cart-item__old-price product-option">
                                {%- if bea_cmp > item.original_price -%}{{- bea_cmp | money -}}{%- else -%}{{- item.original_price | money -}}{%- endif -%}
                              </s>
                              <span class="visually-hidden">
                                {{ 'products.product.price.sale_price' | t }}
                              </span>
                              <strong class="cart-item__final-price product-option">
                                {{ item.final_price | money }}
                              </strong>
                            </div>
                          {%- else -%}
                            <div class="product-option">
                              {{ item.original_price | money }}
                            </div>
                          {%- endif -%}

                          {%- if item.product.has_only_default_variant == false
                            or item.properties.size != 0
                            or item.selling_plan_allocation != null
                          -%}
                            <dl>
                              {%- if item.product.has_only_default_variant == false -%}
                                {%- for option in item.options_with_values -%}
                                  <div class="product-option">
                                    <dt>{{ option.name }}:</dt>
                                    <dd>
                                      {{ option.value -}}
                                      {%- unless forloop.last %}, {% endunless %}
                                    </dd>
                                  </div>
                                {%- endfor -%}
                              {%- endif -%}

                              {%- for property in item.properties -%}
                                {%- assign property_first_char = property.first | slice: 0 -%}
                                {%- if property.last != blank and property_first_char != '_' -%}
                                  <div class="product-option">
                                    <dt>{{ property.first }}:</dt>
                                    <dd>
                                      {%- if property.last contains '/uploads/' -%}
                                        <a
                                          href="{{ property.last }}"
                                          class="link"
                                          target="_blank"
                                          aria-describedby="a11y-new-window-message"
                                        >
                                          {{ property.last | split: '/' | last }}
                                        </a>
                                      {%- else -%}
                                        {{ property.last }}
                                      {%- endif -%}
                                    </dd>
                                  </div>
                                {%- endif -%}
                              {%- endfor -%}
                            </dl>

                            <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                          {%- endif -%}

                          <ul
                            class="discounts list-unstyled"
                            role="list"
                            aria-label="{{ 'customer.order.discount' | t }}"
                          >
                            {%- for discount in item.line_level_discount_allocations -%}
                              <li class="discounts__discount">
                                {{- 'icon-discount.svg' | inline_asset_content -}}
                                {%- comment -%} La Function nombra sus descuentos en espanol e interno ("REGALO GRATIS", "50% OFF UPSELL"): aqui se muestra la etiqueta de la marca en el idioma de la tienda {%- endcomment -%}
                                {%- assign bea_dt = discount.discount_application.title | upcase -%}
                                {%- if bea_dt contains 'UPSELL' or bea_dt contains '50%' -%}{{ 'bealgnd.gi.off50' | t }}{%- elsif bea_dt contains 'REGALO' or bea_dt contains 'GIFT' -%}{{ 'bealgnd.gi.free_gift' | t }}{%- else -%}{{ discount.discount_application.title }}{%- endif -%}
                              </li>
                            {%- endfor -%}
                          </ul>
                        </td>

                        <td class="cart-item__totals right" role="cell" headers="CartDrawer-ColumnTotal">
                          {%- render 'loading-spinner' -%}
                          <div class="cart-item__price-wrapper">
                            {%- if item.original_line_price != item.final_line_price -%}
                              <div class="cart-item__discounted-prices">
                                <span class="visually-hidden">
                                  {{ 'products.product.price.regular_price' | t }}
                                </span>
                                <s class="cart-item__old-price price price--end">
                                  {{ item.original_line_price | money }}
                                </s>
                                <span class="visually-hidden">
                                  {{ 'products.product.price.sale_price' | t }}
                                </span>
                                <span class="price price--end">
                                  {{ item.final_line_price | money }}
                                </span>
                              </div>
                            {%- else -%}
                              <span class="price price--end">
                                {{ item.original_line_price | money }}
                              </span>
                            {%- endif -%}

                            {%- if item.variant.available and item.unit_price_measurement -%}
                              {% render 'unit-price',
                                price: item.unit_price,
                                measurement: item.unit_price_measurement
                              %}
                            {%- endif -%}
                          </div>
                        </td>
                        {%- liquid
                          assign has_qty_rules = false
                          if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                            assign has_qty_rules = true
                          endif

                          assign has_vol_pricing = false
                          if item.variant.quantity_price_breaks.size > 0
                            assign has_vol_pricing = true
                          endif
                        -%}
                        <td
                          class="cart-item__quantity {% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}"
                          role="cell"
                          headers="CartDrawer-ColumnQuantity"
                        >
                          {%- if bea_is_gift -%}<button type="button" class="bea-gift-change" data-bea-gift-change data-line-key="{{ item.key }}" data-variant-id="{{ item.variant_id }}" data-qty="{{ item.quantity }}" data-gift-for="{{ item.properties._bea_gift_for }}">{{ 'bealgnd.gi.change' | t }}</button>{%- endif -%}
<quantity-popover>
                            <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                              <div class="quantity-popover-container">
                                {%- liquid
                                  assign qty_max = 10
                                  if item.variant.quantity_rule.max != null and item.variant.quantity_rule.max < qty_max
                                    assign qty_max = item.variant.quantity_rule.max
                                  endif
                                  if item.quantity > qty_max
                                    assign qty_max = item.quantity
                                  endif
                                -%}
                                <div class="select bea-qty">
                                  <select
                                    class="select__select bea-qty-select"
                                    name="updates[]"
                                    id="Drawer-quantity-{{ item.index | plus: 1 }}"
                                    data-index="{{ item.index | plus: 1 }}"
                                    data-quantity-variant-id="{{ item.variant.id }}"
                                    data-quantity-line-key="{{ item.key }}"
                                    aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                    {% if item.instructions and item.instructions.can_update_quantity == false %}disabled{% endif %}
                                  >
                                    {%- for i in (1..qty_max) -%}
                                      <option value="{{ i }}"{% if i == item.quantity %} selected{% endif %}>{{ i }}</option>
                                    {%- endfor -%}
                                  </select>
                                  <span class="svg-wrapper bea-qty-caret">
                                    {{- 'icon-caret.svg' | inline_asset_content -}}
                                  </span>
                                </div>
                              </div>
                              <cart-remove-button
                                id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                                data-index="{{ item.index | plus: 1 }}"
                              >
                                <button
                                  type="button"
                                  class="button button--tertiary cart-remove-button"
                                  aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                                  data-variant-id="{{ item.variant.id }}"
                                  {% if item.instructions and item.instructions.can_remove == false %}
                                    class="hidden"
                                  {% endif %}
                                >
                                  {{ 'bealgnd.cart.remove' | t }}
                                </button>
                              </cart-remove-button>
                            </div>
                            {%- if has_qty_rules or has_vol_pricing -%}
                              <button
                                type="button"
                                class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary"
                                aria-expanded="false"
                              >
                                <span class="svg-wrapper">
                                  {{- 'icon-info.svg' | inline_asset_content -}}
                                </span>
                                <span>
                                  {%- if has_vol_pricing -%}
                                    {{ 'products.product.volume_pricing.note' | t }}
                                  {%- elsif has_qty_rules -%}
                                    {{ 'products.product.quantity.note' | t }}
                                  {%- endif -%}
                                </span>
                              </button>
                            {%- endif -%}
                            {%- if has_vol_pricing or has_qty_rules -%}
                              <div
                                class="cart-items__info global-settings-popup quantity-popover__info"
                                tabindex="-1"
                                hidden
                              >
                                {%- if has_qty_rules == false -%}
                                  <span class="volume-pricing-label caption">
                                    {{- 'products.product.volume_pricing.title' | t -}}
                                  </span>
                                {%- endif -%}
                                <div class="quantity__rules caption">
                                  {%- if item.variant.quantity_rule.increment > 1 -%}
                                    <span class="divider">
                                      {{-
                                        'products.product.quantity.multiples_of'
                                        | t: quantity: item.variant.quantity_rule.increment
                                      -}}
                                    </span>
                                  {%- endif -%}
                                  {%- if item.variant.quantity_rule.min > 1 -%}
                                    <span class="divider">
                                      {{-
                                        'products.product.quantity.min_of'
                                        | t: quantity: item.variant.quantity_rule.min
                                      -}}
                                    </span>
                                  {%- endif -%}
                                  {%- if item.variant.quantity_rule.max != null -%}
                                    <span class="divider">
                                      {{-
                                        'products.product.quantity.max_of'
                                        | t: quantity: item.variant.quantity_rule.max
                                      -}}
                                    </span>
                                  {%- endif -%}
                                </div>
                                <button
                                  class="button-close button button--tertiary"
                                  type="button"
                                  aria-label="{{ 'accessibility.close' | t }}"
                                >
                                  <span class="svg-wrapper">
                                    {{- 'icon-close.svg' | inline_asset_content -}}
                                  </span>
                                </button>
                                {%- if item.variant.quantity_price_breaks.size > 0 -%}
                                  <volume-pricing class="parent-display">
                                    <ul class="list-unstyled">
                                      <li>
                                        <span>{{ item.variant.quantity_rule.min }}+</span>
                                        <span>{{ item.variant.price | money_with_currency }}/ea</span>
                                      </li>
                                      {%- for price_break in item.variant.quantity_price_breaks -%}
                                        <li>
                                          <span>
                                            {{- price_break.minimum_quantity -}}
                                            <span aria-hidden="true">+</span></span
                                          >
                                          <span>{{ price_break.price | money_with_currency }}/ea</span>
                                        </li>
                                      {%- endfor -%}
                                    </ul>
                                  </volume-pricing>
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                            <div
                              id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}"
                              class="cart-item__error"
                              role="alert"
                            >
                              <small class="cart-item__error-text"></small>
                              <span class="svg-wrapper">
                                {{- 'icon-error.svg' | inline_asset_content -}}
                              </span>
                            </div>
                          </quantity-popover>
                        </td>
                      </tr>
                    {%- endfor -%}
                  </tbody>
                </table>
                {%- render 'bea-cart-set', part: 'cards' -%}
              </div>
            {%- endif -%}
            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
            <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
              {{ 'accessibility.loading' | t }}
            </p>
          </div>
          <div id="CartDrawer-CartErrors" role="alert"></div>
        </form>
      </cart-drawer-items>
      <div class="drawer__footer">

        {%- comment -%} ===== BEA · Gift picker BOGO (Nivel 2) =====
             Se renderiza SIEMPRE (tambien con carrito vacio): el snippet ya oculta su HTML si no hay items,
             pero asi su <script> queda cargado desde el principio. Si solo se inyecta al re-renderizar el
             drawer tras un add-to-cart, el script llega por innerHTML y no se ejecuta -> botones muertos. {%- endcomment -%}
        {%- render 'bea-cart-set' -%}

        {%- comment -%} El upsell de pago solo se muestra cuando el regalo YA esta aplicado (cart.total_discount > 0) {%- endcomment -%}
        {%- if settings.cart_upsell_product != blank and cart != empty and cart.total_discount > 0 -%}
          {%- assign up = settings.cart_upsell_product -%}
          {%- assign upv = up.selected_or_first_available_variant -%}
          {%- assign up_in_cart = false -%}
          {%- for it in cart.items -%}
            {%- if it.product.id == up.id -%}{%- assign up_in_cart = true -%}{%- endif -%}
          {%- endfor -%}
          {%- unless up_in_cart -%}
            <div class="bea-upsell">
              <div class="bea-upsell__head">
                <span class="bea-upsell__title">{{ 'bealgnd.cart.upsell_title' | t }}</span>
                <span class="bea-upsell__dismiss">{{ 'bealgnd.cart.upsell_dismiss' | t }}</span>
              </div>
              <div class="bea-upsell__card">
                {%- if up.featured_image -%}
                  <img
                    class="bea-upsell__img"
                    src="{{ up.featured_image | image_url: width: 200 }}"
                    alt="{{ up.title | escape }}"
                    width="100"
                    height="100"
                    loading="lazy"
                  >
                {%- endif -%}
                <div class="bea-upsell__info">
                  <span class="bea-upsell__name">{{ up.title }}</span>
                  <span class="bea-upsell__price">{{ upv.price | money }}</span>
                </div>
                <button
                  type="button"
                  class="bea-upsell__add"
                  data-variant-id="{{ upv.id }}"
                  aria-label="{{ 'bealgnd.cart.upsell_add' | t: product: up.title | escape }}"
                >
                  <svg viewBox="0 -960 960 960" width="24" height="24" fill="#272727" aria-hidden="true"><path d="M460-460H240v-40h220v-220h40v220h220v40H500v220h-40z"/></svg>
                </button>
              </div>
            </div>
          {%- endunless -%}
        {%- endif -%}
        {%- if settings.show_cart_note -%}
          <details id="Details-CartDrawer">
            <summary>
              <span class="summary__title">
                {{ 'sections.cart.note' | t }}
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </summary>
            <cart-note class="cart__note field">
              <label class="visually-hidden" for="CartDrawer-Note">{{ 'sections.cart.note' | t }}</label>
              <textarea
                id="CartDrawer-Note"
                class="text-area text-area--resize-vertical field__input"
                name="note"
                placeholder="{{ 'sections.cart.note' | t }}"
              >{{ cart.note }}</textarea>
            </cart-note>
          </details>
        {%- endif -%}

        <!-- Start blocks -->
        <!-- Subtotals -->

        <div class="cart-drawer__footer" {{ block.shopify_attributes }}>
          <div>
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                {%- for discount in cart.cart_level_discount_applications -%}
                  <li class="discounts__discount discounts__discount--end">
                    {{- 'icon-discount.svg' | inline_asset_content -}}
                    {{ discount.title | escape }}
                    (-{{ discount.total_allocated_amount | money }})
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>

          {%- comment -%} La confirmacion de ahorro ya se muestra en la caja verde del gift-picker {%- endcomment -%}
          <div class="totals" role="status">
            <h2 class="totals__total">{{ 'sections.cart.estimated_total' | t }}</h2>
            <p class="totals__total-value">{{ cart.total_price | money_with_currency }}</p>
          </div>

          <small class="tax-note caption-large rte">
            {%- if cart.duties_included and cart.taxes_included -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{
                  'sections.cart.duties_and_taxes_included_shipping_at_checkout_with_policy_html'
                  | t: link: shop.shipping_policy.url
                }}
              {%- endif -%}
            {%- elsif cart.duties_included == false and cart.taxes_included -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{
                  'sections.cart.taxes_included_shipping_at_checkout_with_policy_html'
                  | t: link: shop.shipping_policy.url
                }}
              {%- endif -%}
            {%- elsif cart.duties_included and cart.taxes_included == false -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{
                  'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_with_policy_html'
                  | t: link: shop.shipping_policy.url
                }}
              {%- endif -%}
            {%- elsif cart.duties_included == false and cart.taxes_included == false -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{
                  'sections.cart.taxes_at_checkout_shipping_at_checkout_with_policy_html'
                  | t: link: shop.shipping_policy.url
                }}
              {%- endif -%}
            {%- endif -%}
          </small>
        </div>

        <!-- CTAs -->

        {%- render 'bea-cart-set', part: 'pill' -%}
<div class="cart__ctas" {{ block.shopify_attributes }}>
          <button
            type="submit"
            id="CartDrawer-Checkout"
            class="cart__checkout-button button"
            name="checkout"
            form="CartDrawer-Form"
            {% if cart == empty %}
              disabled
            {% endif %}
          >
            <span>{{ 'sections.cart.checkout' | t }}</span>
            <span class="cart__checkout-button-text">{%- liquid
              assign bea_bf_save = 0
              for bit in cart.items
                assign bc = bit.variant.compare_at_price | default: 0
                if bit.final_line_price > 0 and bc > bit.original_price
                  assign bd = bc | minus: bit.original_price | times: bit.quantity
                  assign bea_bf_save = bea_bf_save | plus: bd
                endif
              endfor
              assign bea_was_tot = cart.original_total_price | plus: bea_bf_save
            -%}{%- if bea_was_tot > cart.total_price -%}<s class="bea-was">{{ bea_was_tot | money }}</s>{%- endif -%}{{ cart.total_price | money }}</span>
          </button>
        </div>

        {%- if shop.enabled_payment_types.size > 0 -%}
          {%- assign bea_pay_allowed = 'visa,master,american_express,paypal,apple_pay,shopify_pay,google_pay,klarna' | split: ',' -%}
          <div class="bea-payments" role="list" aria-label="{{ 'bealgnd.cart.payment_methods' | t }}">
            {%- for type in shop.enabled_payment_types -%}
              {%- if bea_pay_allowed contains type -%}
                {{ type | payment_type_svg_tag: class: 'bea-payment-icon' }}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</cart-drawer>

<style>
  .bea-savings{display:flex;justify-content:space-between;align-items:center;font-family:'Inter',sans-serif;
    font-size:12px;letter-spacing:-.02em;color:#2f9e40;font-weight:600;margin:0 0 6px;}
  .bea-shipline{font-family:'Inter',sans-serif;font-size:11px;letter-spacing:-.02em;
    color:rgba(18,18,18,.7);margin:4px 0 0;}

  /* ===== Titulo del drawer: tracking cerrado (Dawn lo abre por defecto) ===== */
  .drawer__heading{letter-spacing:-.02em !important;}

  /* ===== Barra de progreso con hitos (estilo MIS) ===== */
  /* Alineada con el titulo (sin sangria), ancho completo, ritmo vertical: titulo 38 / frase 36 / barra 10 / etiquetas */
  .bea-progress--milestones{margin:6px 0 4px;padding:0 15px !important;font-family:'Inter',sans-serif;}
  .bea-prog__msg{font-size:11.5px;letter-spacing:-.02em;color:#121212;text-align:left;margin:0 0 24px;font-weight:400;}
  .bea-prog__msg b{font-weight:600;}
  .bea-prog__track{position:relative;height:3px;background:rgba(18,18,18,.12);border-radius:99px;margin:0 0 10px;}
  .bea-prog__fill{display:block !important;position:absolute;left:0;top:0;height:100%;border-radius:99px;background:#3aab52;transition:width .7s cubic-bezier(.22,.61,.36,1);}
  .bea-prog__dot{position:absolute;top:50%;transform:translate(-50%,-50%);width:22px;height:22px;
    border-radius:50%;background:#fff;border:2px solid rgba(18,18,18,.18);display:flex;align-items:center;justify-content:center;box-sizing:border-box;transition:background .3s ease,border-color .3s ease;}
  .bea-prog__dot svg{width:12px;height:12px;}
  .bea-prog__dot--ship{left:50%;}
  .bea-prog__dot--gift{left:100%;transform:translate(-100%,-50%);}
  .bea-prog__dot.is-done{background:#121212;border-color:#121212;}
  .bea-prog__labels{position:relative;height:12px;margin:0;}
  .bea-prog__lab{position:absolute;top:0;font-size:8.5px;font-weight:600;letter-spacing:.03em;
    text-transform:uppercase;color:rgba(18,18,18,.4);white-space:nowrap;transition:color .3s ease;}
  .bea-prog__lab.is-done{color:#121212;}
  .bea-prog__lab--ship{left:50%;transform:translateX(-50%);}
  /* ultimo hito: el texto termina en el borde derecho, como en la referencia */
  .bea-prog__lab--gift{left:100%;transform:translateX(-100%);}
</style>

<script>
  (function () {
    if (window.__beaQtyBound) return;
    window.__beaQtyBound = true;

    /* Raiz localizada ("/" en ingles, "/fr/" en frances...) para que el cajon se re-renderice en el idioma activo */
    var beaRoot = {{ routes.root_url | json }};
    if (beaRoot.charAt(beaRoot.length - 1) !== '/') beaRoot += '/';
    window.beaRoot = beaRoot;

    var beaRefreshSeq = 0;
    function refreshDrawer() {
      /* Si se lanzan dos refrescos seguidos, solo pinta el ultimo (evita que una respuesta vieja tape una nueva) */
      var seq = ++beaRefreshSeq;
      return fetch(beaRoot + 'cart?section_id=cart-drawer')
        .then(function (r) { return r.text(); })
        .then(function (html) {
          if (seq !== beaRefreshSeq) return;
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var nd = doc.querySelector('cart-drawer');
          var d = document.querySelector('cart-drawer');
          var willBeEmpty = nd && nd.classList.contains('is-empty');
          /* Si el cajon se pinto vacio al cargar la pagina, no tiene la estructura de lineas: hay que sustituirlo entero (si no, queda en blanco tras el pop-up de B) */
          var wasEmpty = !!document.querySelector('#CartDrawer .drawer__inner-empty') || !document.querySelector('#CartDrawer .drawer__header');
          if (willBeEmpty || wasEmpty) {
            var newCD = doc.querySelector('#CartDrawer'), curCD = document.querySelector('#CartDrawer');
            if (newCD && curCD) {
              curCD.innerHTML = newCD.innerHTML;
              /* innerHTML borra el listener del fondo oscuro: lo volvemos a poner para que cerrar tocando fuera siga funcionando */
              var ov = curCD.querySelector('#CartDrawer-Overlay');
              if (ov && d && typeof d.close === 'function') ov.addEventListener('click', d.close.bind(d));
            }
          } else {
            ['cart-drawer-items', '.drawer__footer'].forEach(function (sel) {
              var cur = document.querySelector(sel), nw = doc.querySelector(sel);
              if (cur && nw) cur.replaceWith(nw);
            });
            var nc = doc.querySelector('.drawer__heading--small'), cc = document.querySelector('.drawer__heading--small');
            if (nc && cc) cc.textContent = nc.textContent;
          }
          if (d && nd) d.classList.toggle('is-empty', willBeEmpty);
          /* Tras repintar, el candado de regalos revisa el carrito real (solo vuelve a repintar si ha tenido que corregir algo) */
          if (!willBeEmpty && typeof window.beaGiftGuard === 'function') setTimeout(window.beaGiftGuard, 50);
          fetch(beaRoot + 'cart?section_id=cart-icon-bubble').then(function (r) { return r.text(); }).then(function (txt) {
            var cb = document.getElementById('cart-icon-bubble');
            if (!cb) return;
            var bd = new DOMParser().parseFromString(txt, 'text/html');
            var src = bd.querySelector('.shopify-section') || bd.body;
            if (src) cb.innerHTML = src.innerHTML;
          }).catch(function () {});
        })
        .catch(function () {});
    }
    window.beaCartRefresh = refreshDrawer;

    function closeDrawer() {
      var drawer = document.querySelector('cart-drawer');
      if (!drawer) return;
      if (typeof drawer.close === 'function') {
        try { drawer.close(); return; } catch (e) {}
      }
      drawer.classList.remove('active', 'animate');
      document.body.classList.remove('overflow-hidden', 'overflow-hidden-mobile', 'overflow-hidden-tablet', 'overflow-hidden-desktop');
    }

    /* BEA · Regalo incluido: al cambiar o quitar un bolso de la oferta, los regalos nunca superan el numero de bolsos */
function beaLinkedChange(line, quantity) {
  var post = function (url, body) { return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body) }); };
  var row = document.getElementById('CartDrawer-Item-' + line);
  if (!row || !row.hasAttribute('data-buy') || !row.getAttribute('data-line-key')) return post('/cart/change.js', { line: parseInt(line, 10), quantity: quantity });
  var oldQ = parseInt(row.getAttribute('data-qty'), 10) || 0;
  var buyTotal = 0;
  document.querySelectorAll('#CartDrawer tr.cart-item[data-buy]').forEach(function (r) { buyTotal += parseInt(r.getAttribute('data-qty'), 10) || 0; });
  var newBuy = buyTotal - oldQ + quantity;
  var gifts = Array.prototype.slice.call(document.querySelectorAll('#CartDrawer tr.cart-item[data-bea-gift]'));
  var giftTotal = 0; gifts.forEach(function (g) { giftTotal += parseInt(g.getAttribute('data-qty'), 10) || 0; });
  var updates = {}; updates[row.getAttribute('data-line-key')] = quantity;
  if (giftTotal > newBuy) {
    var extra = giftTotal - newBuy;
    for (var i = gifts.length - 1; i >= 0 && extra > 0; i--) {
      var gq = parseInt(gifts[i].getAttribute('data-qty'), 10) || 0, cut = Math.min(gq, extra);
      updates[gifts[i].getAttribute('data-line-key')] = gq - cut; extra -= cut;
    }
  } else if (quantity > oldQ && gifts.length === 1) {
    var g0 = parseInt(gifts[0].getAttribute('data-qty'), 10) || 0;
    updates[gifts[0].getAttribute('data-line-key')] = Math.min(newBuy, g0 + (quantity - oldQ));
  }
  return post('/cart/update.js', { updates: updates });
}

/* BEA · Regalo incluido: si tras un cambio queda un bolso de oferta y ningun regalo (p. ej. al quitar el bolso de viaje,
   los bolsos de la oferta 2 vuelven a tener regalo), se vuelve a poner el regalo por defecto del color del bolso. */
function beaEnsureGift(cart) {
  try {
    var el = document.getElementById('bea-cart-gift-data');
    if (!cart || !cart.items || !cart.items.length || !el) return Promise.resolve(false);
    var d = JSON.parse(el.textContent);
    var b1 = (d.buy1 || []).map(String), b2 = (d.buy2 || []).map(String), gids = {};
    (d.g1 || []).concat(d.g2 || []).forEach(function (g) { g.variants.forEach(function (v) { gids[String(v.id)] = true; }); });
    var isGift = function (it) { var p = it.properties || {}; return !!(p._bea_gift || p._bea_gift_for || (it.final_line_price === 0 && it.original_line_price > 0 && gids[String(it.variant_id)])); };
    var paid = cart.items.filter(function (it) { return !isGift(it); });
    if (paid.length !== cart.items.length) return Promise.resolve(false);
    var anyO1 = paid.some(function (it) { return b1.indexOf(String(it.product_id)) > -1; });
    var active = anyO1 ? b1 : b2, anchor = null;
    paid.forEach(function (it) { if (active.indexOf(String(it.product_id)) > -1 && (!anchor || it.original_price > anchor.original_price)) anchor = it; });
    if (!anchor) return Promise.resolve(false);
    var list = (anyO1 ? d.g1 : d.g2) || [];
    var gp = null;
    list.forEach(function (g) { if (!gp && anyO1 && g.handle === 'bealgnd-pouch-handbag-monogram') gp = g; });
    gp = gp || list[0];
    if (!gp || !gp.variants || !gp.variants.length) return Promise.resolve(false);
    var canon = function (s) { s = String(s || '').toLowerCase(); return ({ negro: 'black', noir: 'black', verde: 'green', vert: 'green', azul: 'blue', bleu: 'blue', blanco: 'white', blanc: 'white' })[s] || s; };
    var col = '';
    (anchor.options_with_values || []).forEach(function (o) { if (!col && /colou?r|colores|couleur/i.test(o.name)) col = o.value; });
    var pick = function (c) { for (var i = 0; i < gp.variants.length; i++) if (canon(gp.variants[i].color) === canon(c)) return gp.variants[i]; return null; };
    var v = pick(col) || pick('Black') || gp.variants[0];
    return fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items: [{ id: Number(v.id), quantity: 1, properties: { _bea_gift: '1' } }] }) })
      .then(function (r) { return r.ok; }, function () { return false; });
  } catch (e) { return Promise.resolve(false); }
}
window.beaEnsureGift = beaEnsureGift;

function changeLine(line, quantity) {
      var items = document.getElementById('CartDrawer-CartItems');
      if (items) items.classList.add('cart__items--disabled');
      beaLinkedChange(line, quantity)
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          if (cart && cart.item_count === 0) {
            closeDrawer();
            setTimeout(refreshDrawer, 360);
            return;
          }
          return beaEnsureGift(cart).then(function () { return refreshDrawer(); });
        })
        .catch(function () {})
        .finally(function () { if (items) items.classList.remove('cart__items--disabled'); });
    }

    document.addEventListener('change', function (e) {
      var sel = e.target && e.target.closest ? e.target.closest('.bea-qty-select') : null;
      if (!sel) return;
      e.stopPropagation();
      changeLine(sel.dataset.index, parseInt(sel.value, 10));
    }, true);

    document.addEventListener('click', function (e) {
      var rb = e.target && e.target.closest ? e.target.closest('cart-remove-button') : null;
      if (!rb) return;
      e.preventDefault();
      e.stopImmediatePropagation();
      changeLine(rb.dataset.index, 0);
    }, true);
  })();
</script>

<script>
  (function () {
    if (window.__beaProgressBound) return;
    window.__beaProgressBound = true;

    var CHECK_W = '<svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
    var CHECK_G = '<svg viewBox="0 0 24 24" fill="none" stroke="rgba(18,18,18,.35)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';

    /* Mensajes i18n de la barra (claves bealgnd.cart.*, resueltas por | t). Llevan <b> dentro. */
    var MSG_GIFT = {{ 'bealgnd.gi.progress_gift_in_cart_html' | t | json }};
    var MSG_ADD  = {{ 'bealgnd.cart.progress_add_for_gift_html' | t | json }};
    var MSG_SHIP = {{ 'bealgnd.cart.progress_shipping_unlocked_html' | t | json }};

    // Actualiza EN SITIO (solo width/clases/texto) para que el transition anime.
    function update(el, total, giftUnlocked) {
      if (!el) return;
      var threshold = parseInt(el.getAttribute('data-threshold'), 10) || 12000;
      var shipDone = total >= threshold;

      var fillPct = 0;
      if (giftUnlocked) fillPct = 100;
      else if (shipDone) fillPct = 50;

      var msg = el.querySelector('.bea-prog__msg');
      var fill = el.querySelector('.bea-prog__fill');
      var dotShip = el.querySelector('.bea-prog__dot--ship');
      var dotGift = el.querySelector('.bea-prog__dot--gift');
      var labShip = el.querySelector('.bea-prog__lab--ship');
      var labGift = el.querySelector('.bea-prog__lab--gift');

      if (fill) fill.style.width = fillPct + '%';           // <- esto SÍ anima con transition
      if (msg) {
        if (giftUnlocked) msg.innerHTML = MSG_GIFT;
        else if (shipDone) msg.innerHTML = MSG_ADD;
        else msg.innerHTML = MSG_SHIP;
      }
      if (dotShip) { dotShip.classList.toggle('is-done', shipDone); dotShip.innerHTML = shipDone ? CHECK_W : CHECK_G; }
      if (dotGift) { dotGift.classList.toggle('is-done', !!giftUnlocked); dotGift.innerHTML = giftUnlocked ? CHECK_W : CHECK_G; }
      if (labShip) labShip.classList.toggle('is-done', shipDone);
      if (labGift) labGift.classList.toggle('is-done', !!giftUnlocked);
    }

    var busy = false;
    function updateFromCart() {
      if (busy) return;
      busy = true;
      fetch('/cart.js', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (c) {
          var gift = c.total_discount > 0 ? 1 : 0;
          document.querySelectorAll('.bea-progress').forEach(function (el) {
            el.setAttribute('data-gift-unlocked', gift);
            update(el, c.total_price, gift);
          });
        })
        .catch(function () {})
        .finally(function () { setTimeout(function () { busy = false; }, 60); });
    }

    var root = document.getElementById('CartDrawer');
    if (root) {
      var t;
      new MutationObserver(function () {
        if (busy) return;
        clearTimeout(t);
        t = setTimeout(updateFromCart, 250);
      }).observe(root, { childList: true, subtree: true });
    }

    // Anima el relleno desde 0 hasta su valor real cada vez que se ABRE el carrito
    function animateOpen() {
      document.querySelectorAll('.bea-progress').forEach(function (el) {
        var fill = el.querySelector('.bea-prog__fill');
        if (!fill) return;
        var target = parseInt(el.getAttribute('data-fill-target'), 10) || 0;
        // corta la transicion, pone a 0 al instante
        fill.style.transition = 'none';
        fill.style.width = '0%';
        void fill.offsetWidth;                    // reflow: registra el 0
        // reactiva la transicion y lanza al target con un pequeno respiro
        setTimeout(function () {
          fill.style.transition = '';             // vuelve al transition del CSS
          fill.style.width = target + '%';
        }, 120);
      });
    }

    // dispara al cargar y cuando el cart-drawer pasa a estado abierto (clase active)
    animateOpen();
    var drawer = document.querySelector('cart-drawer');
    if (drawer) {
      new MutationObserver(function (muts) {
        for (var i = 0; i < muts.length; i++) {
          if (muts[i].attributeName === 'class' && drawer.classList.contains('active')) {
            animateOpen();
            break;
          }
        }
      }).observe(drawer, { attributes: true, attributeFilter: ['class'] });
    }
  })();
</script>

<script>
  (function () {
    if (window.__beaUpsellBound) return;
    window.__beaUpsellBound = true;

    function refreshDrawer() {
      if (typeof window.beaCartRefresh === 'function') return window.beaCartRefresh();
      var beaRoot = window.beaRoot || '/';
      return fetch(beaRoot + 'cart?section_id=cart-drawer')
        .then(function (r) { return r.text(); })
        .then(function (html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          ['cart-drawer-items', '.drawer__footer'].forEach(function (sel) {
            var t = document.querySelector(sel), s = doc.querySelector(sel);
            if (t && s) t.replaceWith(s);
          });
          var nc = doc.querySelector('.drawer__heading--small'), cc = document.querySelector('.drawer__heading--small');
          if (nc && cc) cc.textContent = nc.textContent;
        })
        .catch(function () {});
    }

    document.addEventListener('click', function (e) {
      var add = e.target && e.target.closest ? e.target.closest('.bea-upsell__add') : null;
      if (add) {
        e.preventDefault();
        var id = add.getAttribute('data-variant-id');
        if (!id) return;
        add.disabled = true;
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: [{ id: parseInt(id, 10), quantity: 1 }] }),
        })
          .then(function (r) { return r.json(); })
          .then(function () { return refreshDrawer(); })
          .then(function () { var box = add.closest('.bea-upsell'); if (box) box.style.display = 'none'; })
          .catch(function () { add.disabled = false; });
        return;
      }
      var no = e.target && e.target.closest ? e.target.closest('.bea-upsell__dismiss') : null;
      if (no) {
        e.preventDefault();
        var box2 = no.closest('.bea-upsell');
        if (box2) box2.style.display = 'none';
        try { sessionStorage.setItem('bea_upsell_dismissed', '1'); } catch (_) {}
      }
    });

    try {
      if (sessionStorage.getItem('bea_upsell_dismissed') === '1') {
        document.querySelectorAll('.bea-upsell').forEach(function (b) { b.style.display = 'none'; });
      }
    } catch (_) {}
  })();
</script>

<script>
  (function () {
    if (window.__beaScrollGuard) return;
    window.__beaScrollGuard = true;
    var drawer = document.querySelector('cart-drawer');
    var menu = document.getElementById('Details-menu-drawer-container');
    function unlockIfClosed() {
      var cartOpen = drawer && drawer.classList.contains('active');
      var menuOpen = menu && menu.hasAttribute('open');
      if (!cartOpen && !menuOpen) {
        document.body.classList.remove('overflow-hidden', 'overflow-hidden-mobile', 'overflow-hidden-tablet', 'overflow-hidden-desktop', 'bea-menu-open');
        document.body.style.overflow = '';
        document.documentElement.style.overflow = '';
      }
    }
    if (drawer) new MutationObserver(unlockIfClosed).observe(drawer, { attributes: true, attributeFilter: ['class'] });
    if (menu) new MutationObserver(unlockIfClosed).observe(menu, { attributes: true, attributeFilter: ['open'] });
  })();
</script>

