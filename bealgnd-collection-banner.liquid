{%- comment -%}
  BEALGND · Banner de colección (imagen + etiqueta de oferta)
  Banner de imagen para anunciar ofertas (p. ej. buy 1, get 1 free) arriba de la
  cabecera de colección. Imagen distinta en móvil (opcional). Etiqueta glass
  superpuesta abajo a la derecha con icono de regalo. Alto fijo con recorte.
{%- endcomment -%}

{%- style -%}
  #bea-colbanner-{{ section.id }} {
    max-width: {{ settings.page_width }}px;
    margin: {{ section.settings.margin_top }}px auto {{ section.settings.margin_bottom }}px;
    padding: 0 1.5rem;
  }
  #bea-colbanner-{{ section.id }} .bea-colbanner__media {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 12px;
    height: {{ section.settings.height_mobile }}px;
  }
  #bea-colbanner-{{ section.id }} .bea-colbanner__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Movil: solo la imagen de movil */
  #bea-colbanner-{{ section.id }} .bea-colbanner__img--desktop { display: none !important; }
  #bea-colbanner-{{ section.id }} .bea-colbanner__img--mobile { display: block !important; }
  @media screen and (min-width: 750px) {
    #bea-colbanner-{{ section.id }} .bea-colbanner__media { height: {{ section.settings.height_desktop }}px; }
    #bea-colbanner-{{ section.id }} .bea-colbanner__img--desktop { display: block !important; }
    #bea-colbanner-{{ section.id }} .bea-colbanner__img--mobile { display: none !important; }
  }
  {%- if section.settings.image_mobile == blank -%}
    #bea-colbanner-{{ section.id }} .bea-colbanner__img--desktop { display: block !important; }
  {%- endif -%}

  /* Etiqueta de oferta (glass claro, abajo a la derecha) */
  #bea-colbanner-{{ section.id }} .bea-colbanner__tag {
    position: absolute;
    right: 14px;
    bottom: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.75);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: #121212;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
    padding: 8px 14px;
    border-radius: 10px;
    white-space: nowrap;
    z-index: 2;
  }
  #bea-colbanner-{{ section.id }} .bea-colbanner__tag svg {
    width: 14px;
    height: 14px;
    flex: 0 0 auto;
    display: block;
  }
{%- endstyle -%}

{%- capture bea_tag -%}
  {%- if section.settings.show_tag and section.settings.tag_text != blank -%}
    <span class="bea-colbanner__tag">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="20 12 20 22 4 22 4 12"></polyline>
        <rect x="2" y="7" width="20" height="5"></rect>
        <line x1="12" y1="22" x2="12" y2="7"></line>
        <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
        <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
      </svg>
      {{ section.settings.tag_text }}
    </span>
  {%- endif -%}
{%- endcapture -%}

<div id="bea-colbanner-{{ section.id }}" class="bea-colbanner">
  {%- if section.settings.image != blank -%}
    {%- capture banner_media -%}
      <div class="bea-colbanner__media">
        <img
          class="bea-colbanner__img--desktop"
          src="{{ section.settings.image | image_url: width: 1600 }}"
          srcset="
            {{ section.settings.image | image_url: width: 750 }} 750w,
            {{ section.settings.image | image_url: width: 1100 }} 1100w,
            {{ section.settings.image | image_url: width: 1500 }} 1500w,
            {{ section.settings.image | image_url: width: 1920 }} 1920w
          "
          sizes="100vw"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
        {%- if section.settings.image_mobile != blank -%}
          <img
            class="bea-colbanner__img--mobile"
            src="{{ section.settings.image_mobile | image_url: width: 900 }}"
            srcset="
              {{ section.settings.image_mobile | image_url: width: 450 }} 450w,
              {{ section.settings.image_mobile | image_url: width: 750 }} 750w,
              {{ section.settings.image_mobile | image_url: width: 1000 }} 1000w
            "
            sizes="100vw"
            alt="{{ section.settings.image_mobile.alt | escape }}"
            width="{{ section.settings.image_mobile.width }}"
            height="{{ section.settings.image_mobile.height }}"
            loading="lazy"
          >
        {%- endif -%}
        {{ bea_tag }}
      </div>
    {%- endcapture -%}

    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="bea-colbanner__link" aria-label="{{ section.settings.image.alt | escape | default: 'Banner' }}">
        {{ banner_media }}
      </a>
    {%- else -%}
      {{ banner_media }}
    {%- endif -%}
  {%- else -%}
    <div class="bea-colbanner__media">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {{ bea_tag }}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "BEALGND Banner",
  "tag": "section",
  "class": "section bea-colbanner-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Banner de imagen para anunciar ofertas arriba de la cabecera de coleccion. Sube una imagen para escritorio y otra para movil."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen (escritorio)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen (movil)",
      "info": "Opcional. Si la subes, se usa solo en movil (ideal para un formato mas vertical)."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace (opcional)"
    },
    {
      "type": "header",
      "content": "Etiqueta de oferta"
    },
    {
      "type": "checkbox",
      "id": "show_tag",
      "label": "Mostrar etiqueta",
      "default": true
    },
    {
      "type": "text",
      "id": "tag_text",
      "label": "Texto de la etiqueta",
      "default": "buy 1, get 1 free"
    },
    {
      "type": "header",
      "content": "Alto del banner"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 120,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Alto en escritorio",
      "default": 320
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 120,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Alto en movil",
      "default": 300
    },
    {
      "type": "header",
      "content": "Margenes"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Margen superior",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Margen inferior",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "BEALGND Banner"
    }
  ]
}
{% endschema %}
